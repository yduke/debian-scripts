TMP_DIR="$(mktemp -d)"
CERT_FILE="${TMP_DIR}/${DOMAIN}.crt"
KEY_FILE="${TMP_DIR}/${DOMAIN}.key"
PEM_FILE="${TMP_DIR}/${DOMAIN}.pem"
ISSUER_FILE="${TMP_DIR}/${DOMAIN}_issuer.crt"

info()    { echo -e "${CYAN}[INFO]${RESET}  $*"; }
success() { echo -e "${GREEN}[OK]${RESET}    $*"; }
warn()    { echo -e "${YELLOW}[WARN]${RESET}  $*"; }
error()   { echo -e "${RED}[ERROR]${RESET} $*" >&2; }
# ─────────────────────────────────────────────
# 清理临时目录（退出时自动执行）
# ─────────────────────────────────────────────
cleanup() {
    rm -rf "${TMP_DIR}"
    if [ "$LANG_MODE" = "en" ]; then
        info "Temporary directory cleaned"
    else
        info "已清理临时目录"
    fi
}
trap cleanup EXIT

# ─────────────────────────────────────────────
# 从文件服务器下载证书文件
# ─────────────────────────────────────────────
download_certs() {
    info "${T_DOWNLOADING_CERTS} ${CERT_SERVER}..."

    local urls=("${CERT_URL}" "${KEY_URL}" "${PEM_URL}" "${ISSUER_URL}")
    local files=("${CERT_FILE}" "${KEY_FILE}" "${PEM_FILE}" "${ISSUER_FILE}")

    for i in "${!urls[@]}"; do
        if [ "$LANG_MODE" = "en" ]; then
            info "  Downloading ${urls[$i]}"
        else
            info "  下载 ${urls[$i]}"
        fi
        if ! curl -fsSL --connect-timeout 10 --max-time 30 \
                "${urls[$i]}" -o "${files[$i]}"; then
            error "${T_DOWNLOAD_FAIL}${urls[$i]}"
            error "${T_CHECK_SERVER}"
            exit 1
        fi
    done

    success "${T_CERTS_DOWNLOADED} ${TMP_DIR}"
}

# ─────────────────────────────────────────────
# 判断系统类型
# ─────────────────────────────────────────────
is_pve() {
    # 同时检查命令与目录，双重确认
    command -v pveversion &>/dev/null && [[ -d /etc/pve ]]
}

is_debian() {
    [[ -f /etc/debian_version ]] || \
    (command -v grep &>/dev/null && grep -qi '^ID=debian' /etc/os-release 2>/dev/null)
}


# ─────────────────────────────────────────────
# PVE 安装逻辑
# ─────────────────────────────────────────────
install_pve() {
    local node
    node="$(hostname)"
    local pve_cert_dir="/etc/pve/nodes/${node}"

    info "${T_PVE_DETECTED}${node}"

    # 1. 备份旧证书
    local backup_dir="/root/cert-backup-$(date +%Y%m%d_%H%M%S)"
    mkdir -p "${backup_dir}"
    if ls "${pve_cert_dir}"/*.pem "${pve_cert_dir}"/*.key &>/dev/null 2>&1; then
        cp "${pve_cert_dir}"/*.pem "${pve_cert_dir}"/*.key "${backup_dir}/" 2>/dev/null || true
        success "${T_CERT_BACKUP_TO} ${backup_dir}"
    fi

    # 2. 强制重置 PVE 证书（清除旧自定义证书）
    info "${T_PVE_FORCE_UPDATE}"
    pvecm updatecerts --force
    success "${T_PVE_UPDATE_DONE}"

    # 3. 将新证书写入 PVE 节点证书目录
    info "${T_INSTALLING_CERT_TO} ${pve_cert_dir}..."

    cat "${CERT_FILE}" "${ISSUER_FILE}" > "${pve_cert_dir}/pveproxy-ssl.pem"
    cp  "${KEY_FILE}"                    "${pve_cert_dir}/pveproxy-ssl.key"

    chmod 640 "${pve_cert_dir}/pveproxy-ssl.pem"
    chmod 600 "${pve_cert_dir}/pveproxy-ssl.key"
    chown root:www-data "${pve_cert_dir}/pveproxy-ssl.pem" 2>/dev/null || \
        chown root:root  "${pve_cert_dir}/pveproxy-ssl.pem"
    chown root:root "${pve_cert_dir}/pveproxy-ssl.key"

    success "${T_CERT_WRITTEN} ${pve_cert_dir}"

    # 4. 重启 pveproxy 使证书生效
    info "${T_RESTARTING_PVEPROXY}"
    systemctl restart pveproxy
    systemctl is-active --quiet pveproxy && \
        success "${T_PVEPROXY_RESTARTED}" || \
        { error "${T_PVEPROXY_FAIL}journalctl -xe -u pveproxy"; exit 1; }

    # 5. 输出验证信息
    echo ""
    info "${T_CERT_VERIFY}"
    openssl x509 -in "${pve_cert_dir}/pveproxy-ssl.pem" \
        -noout -subject -issuer -dates 2>/dev/null \
        | sed 's/^/    /'
    echo ""
    success "${T_PVE_CERT_DONE} https://pve.yins.top:8006"
}


# ─────────────────────────────────────────────
# Debian 安装逻辑
# ─────────────────────────────────────────────
install_debian() {
    info "${T_DEBIAN_DETECTED}"

    # 1. 安装系统级 CA 信任
    info "${T_CA_INSTALLING}"
    local ca_dir="/usr/local/share/ca-certificates"
    mkdir -p "${ca_dir}"
    cp "${ISSUER_FILE}" "${ca_dir}/${DOMAIN}_issuer.crt"
    update-ca-certificates
    success "${T_CA_UPDATED}"

    # 2. 将证书和私钥部署到标准位置
    local ssl_cert_dir="/etc/ssl/certs"
    local ssl_key_dir="/etc/ssl/private"

    info "${T_DEPLOYING_CERT}"

    cat "${CERT_FILE}" "${ISSUER_FILE}" > "${ssl_cert_dir}/${DOMAIN}-fullchain.pem"
    cp  "${KEY_FILE}"                    "${ssl_key_dir}/${DOMAIN}.key"
    cp  "${PEM_FILE}"                    "${ssl_cert_dir}/${DOMAIN}.pem"

    chmod 644 "${ssl_cert_dir}/${DOMAIN}-fullchain.pem"
    chmod 644 "${ssl_cert_dir}/${DOMAIN}.pem"
    chmod 600 "${ssl_key_dir}/${DOMAIN}.key"
    chown root:root "${ssl_cert_dir}/${DOMAIN}-fullchain.pem"
    chown root:root "${ssl_cert_dir}/${DOMAIN}.pem"
    chown root:ssl-cert "${ssl_key_dir}/${DOMAIN}.key" 2>/dev/null || \
        chown root:root  "${ssl_key_dir}/${DOMAIN}.key"

    success "${T_CERT_DEPLOYED}"
    if [ "$LANG_MODE" = "en" ]; then
        echo "    Certificate: ${ssl_cert_dir}/${DOMAIN}-fullchain.pem"
        echo "    PEM       : ${ssl_cert_dir}/${DOMAIN}.pem"
        echo "    Private key: ${ssl_key_dir}/${DOMAIN}.key"
    else
        echo "    证书链：${ssl_cert_dir}/${DOMAIN}-fullchain.pem"
        echo "    PEM   ：${ssl_cert_dir}/${DOMAIN}.pem"
        echo "    私钥  ：${ssl_key_dir}/${DOMAIN}.key"
    fi

    # 3. 验证证书信息
    echo ""
    info "${T_CERT_VERIFY}"
    openssl x509 -in "${ssl_cert_dir}/${DOMAIN}-fullchain.pem" \
        -noout -subject -issuer -dates 2>/dev/null \
        | sed 's/^/    /'
    echo ""

    # 4. 提示后续操作
    warn "${T_CERT_HINT}"
    warn "${T_CERT_NGINX_EXAMPLE1}"
    if [ "$LANG_MODE" = "en" ]; then
        warn "    ssl_certificate     ${ssl_cert_dir}/${DOMAIN}-fullchain.pem;"
        warn "    ssl_certificate_key ${ssl_key_dir}/${DOMAIN}.key;"
    else
        warn "    ssl_certificate     ${ssl_cert_dir}/${DOMAIN}-fullchain.pem;"
        warn "    ssl_certificate_key ${ssl_key_dir}/${DOMAIN}.key;"
    fi

    success "${T_DEBIAN_CERT_DONE}"
}

check_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo -e "${RED}[ERROR] ${T_ROOT_REQUIRED}${RESET}"
        exit 1
    fi
}

update_ssl_certificates() {
    echo ""
    echo -e "${CYAN}============================================${RESET}"
    echo -e "${CYAN}  ${T_SSL_TITLE}  |  *.${DOMAIN}${RESET}"
    echo -e "${CYAN}============================================${RESET}"
    echo ""

    check_root
    download_certs

    if is_pve; then
        install_pve
    elif is_debian; then
        install_debian
    else
        error "${T_OS_UNSUPPORTED}"
        error "${T_OS_SUPPORT_INFO}"
        if [[ -f /etc/os-release ]]; then
            error "${T_OS_INFO}"
            grep -E '^(ID|NAME|VERSION)=' /etc/os-release | sed 's/^/    /' >&2
        fi
        exit 1
    fi
    read -p "${T_DONE}"
}

# ---------- Docker 菜单 ----------
docker_menu() {
    while true; do
        clear
        echo -e "${BLUE}${T_DOCKER_TITLE}${RESET}"
        echo -e "${YELLOW}${T_DOCKER_INSTALL}${RESET}"
        echo -e "${YELLOW}${T_DOCKER_MIRROR}${RESET}"
        echo -e "${YELLOW}${T_RETURN_MAIN}${RESET}"
        read -p "${T_PROMPT}" choice
        case "$choice" in
            1)
                echo -e "${GREEN}${T_DOCKER_INSTALLING}${RESET}"
                require_command curl
                bash <(curl -sSL https://linuxmirrors.cn/docker.sh)
                read -p "${T_PRESS_ENTER}"
                ;;
            2)
                echo -e "${GREEN}${T_DOCKER_MIRROR_MSG}${RESET}"
                require_command curl
                bash <(curl -sSL https://linuxmirrors.cn/docker.sh) --only-registry
                read -p "${T_PRESS_ENTER}"
                ;;
            0) break ;;
            *) echo -e "${RED}${T_INVALID}${RESET}"; sleep 1 ;;
        esac
    done
}

# ---------- 7 系统检查 ----------
system_check_menu() {
    while true; do
        clear
        echo -e "${BLUE}${T_CHECK_TITLE}${RESET}"
        echo -e "${YELLOW}${T_CHECK_REBOOT}${RESET}"
        echo -e "${YELLOW}${T_CHECK_DISK}${RESET}"
        echo -e "${YELLOW}${T_CHECK_DISK_TOP}${RESET}"
        echo -e "${YELLOW}${T_CHECK_LOG}${RESET}"
        echo -e "${YELLOW}${T_CHECK_CPU}${RESET}"
        echo -e "${YELLOW}${T_CHECK_MEM}${RESET}"
        echo -e "${YELLOW}${T_CHECK_SYSINFO}${RESET}"
        echo -e "${YELLOW}${T_CHECK_KERNEL}${RESET}"
        echo -e "${YELLOW}${T_CHECK_FAILED}${RESET}"
        echo -e "${YELLOW}${T_CHECK_IP}${RESET}"
        echo -e "${YELLOW}${T_RETURN_MAIN}${RESET}"
        read -p "${T_PROMPT}" choice
        case "$choice" in
            1)
                if [ -f /var/run/reboot-required ]; then
                    echo -e "${RED}${T_REBOOT_NEEDED}${RESET}"
                    cat /var/run/reboot-required
                else
                    echo -e "${GREEN}${T_NO_REBOOT}${RESET}"
                fi
                read -p "${T_PRESS_ENTER}"
                ;;
            2)
                echo -e "${CYAN}${T_DISK_USAGE}${RESET}"
                hd_percent=$(df --output=pcent / | tail -1 | tr -dc '0-9.')
                hd_used=$(df --output=used / | tail -1)
                hd_used_gb=$(awk -v k="$hd_used" 'BEGIN {printf "%.2f", k/1024/1024}')
                if [ "$LANG_MODE" = "en" ]; then
                    echo "Used ${hd_percent}% (${hd_used_gb} GB)"
                else
                    echo "已使用 ${hd_percent}%，使用了 ${hd_used_gb} GB"
                fi
                read -p "${T_PRESS_ENTER}"
                ;;
            3)
                echo -e "${CYAN}${T_FINDING_DIR}${RESET}"
                du -h /var | sort -hr | head -n 20
                read -p "${T_PRESS_ENTER}"
                ;;
            4)
                echo -e "${CYAN}${T_RECENT_LOG}${RESET}"
                journalctl -n 50
                read -p "${T_PRESS_ENTER}"
                ;;
            5)
                echo -e "${CYAN}${T_CPU_USAGE}${RESET}"
                top -b -n 1 | head -n 5
                read -p "${T_PRESS_ENTER}"
                ;;
            6)
                echo -e "${CYAN}${T_MEM_USAGE}${RESET}"

                get_mem_info() {
                    awk '
                        /MemTotal:/      {total=$2}
                        /MemAvailable:/  {avail=$2}
                        END {
                            used = total - avail
                            printf("%.1f %.2f", used/total*100, used/1024/1024)
                        }
                    ' /proc/meminfo
                }
                read mem_percent mem_used_gb <<< "$(get_mem_info)"
                if [ "$LANG_MODE" = "en" ]; then
                    echo "Used ${mem_percent}% (${mem_used_gb} GB)"
                else
                    echo "已使用 ${mem_percent}%，使用了 ${mem_used_gb} GB"
                fi
                read -p "${T_PRESS_ENTER}"
                ;;
            7)
                echo -e "${CYAN}${T_SYS_CONFIG}${RESET}"
                hostnamectl
                read -p "${T_PRESS_ENTER}"
                ;;
            8)
                echo -e "${CYAN}${T_KERNEL_VER}${RESET}"
                uname -r
                read -p "${T_PRESS_ENTER}"
                ;;
            9)
                echo -e "${CYAN}${T_FAILED_SVC}${RESET}"
                failed=$(systemctl --failed --no-pager --plain --quiet | awk 'NR>1 {print $1}')
                if [ -z "$failed" ]; then
                    echo -e "${GREEN}${T_NO_FAILED_SVC}${RESET}"
                else
                    for svc in $failed; do
                        if [ "$LANG_MODE" = "en" ]; then
                            echo -e "\nService: $svc"
                        else
                            echo -e "\n服务: $svc"
                        fi
                        journalctl -u "$svc" -n 20 --no-pager
                    done
                fi
                read -p "${T_PRESS_ENTER}"
                ;;
            10)
                echo -e "${CYAN}${T_IP_ADDR}${RESET}"
                echo -e "IPV4: ${GREEN}$SERVER_IP${RESET}"
                echo -e "IPV6: ${GREEN}$SERVER_IP6${RESET}"
                read -p "${T_PRESS_ENTER}"
                ;;
            0) break ;;
            *) echo -e "${RED}${T_INVALID}${RESET}"; sleep 1 ;;
        esac
    done
}

# ---------- 更新 ----------
self_update(){
    echo -e "${GREEN}${T_SELF_UPDATING}${RESET}"
    require_command curl
    bash <(curl -fsSL https://raw.githubusercontent.com/yduke/debian-scripts/main/install.sh)
    echo -e "${GREEN}${T_SELF_UPDATED}${RESET}"
    echo -e "${GREEN}${T_SELF_RESTART}${RESET}"
    read -p "${T_SELF_EXIT}"
    exit 0
}

