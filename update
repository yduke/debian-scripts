# ---------- 7 系统检查 ----------
system_check_menu() {
    while true; do
        clear
        echo -e "${BLUE}----- 系统检查 -----${RESET}"
        echo -e "${YELLOW}1)${RESET} 检查是否需要重启"
        echo -e "${YELLOW}2)${RESET} 查看磁盘空间"
        echo -e "${YELLOW}3)${RESET} 查看磁盘占用最大的目录"
        echo -e "${YELLOW}4)${RESET} 查看最近系统日志"
        echo -e "${YELLOW}5)${RESET} 查看 CPU 使用"
        echo -e "${YELLOW}6)${RESET} 查看内存使用"
        echo -e "${YELLOW}7)${RESET} 查看系统配置"
        echo -e "${YELLOW}8)${RESET} 查看内核版本"
        echo -e "${YELLOW}9)${RESET} 查看失败服务"
        echo -e "${YELLOW}10)${RESET} 查看IP地址"
        echo -e "${YELLOW}0)${RESET} 返回主菜单"
        read -p "请输入选项: " choice
        case "$choice" in
            1)
                if [ -f /var/run/reboot-required ]; then
                    echo -e "${RED}系统需要重启！${RESET}"
                    cat /var/run/reboot-required
                else
                    echo -e "${GREEN}不需要重启。${RESET}"
                fi
                read -p "按回车返回..."
                ;;
            2)
                echo -e "${CYAN}磁盘空间使用情况：${RESET}"
			    hd_percent=$(df --output=pcent / | tail -1 | tr -dc '0-9.')
			    hd_used=$(df --output=used / | tail -1)
			    hd_used_gb=$(awk -v k="$hd_used" 'BEGIN {printf "%.2f", k/1024/1024}')
			    echo "已使用 $hd_percent %，使用了 $hd_used_gb GB"
                read -p "按回车返回..."
                ;;
            3)
                echo -e "${CYAN}正在查找大尺寸目录，请稍候...${RESET}"
                du -h /var | sort -hr | head -n 20
                read -p "按回车返回..."
                ;;
            4)
                echo -e "${CYAN}最近 50 行系统日志：${RESET}"
                journalctl -n 50
                read -p "按回车返回..."
                ;;
            5)
                echo -e "${CYAN}CPU 使用情况：${RESET}"
                top -b -n 1 | head -n 5
                read -p "按回车返回..."
                ;;
            6)
                echo -e "${CYAN}内存使用情况：${RESET}"

                get_mem_info() {
                    awk '
                        /MemTotal:/      {total=$2}
                        /MemAvailable:/  {avail=$2}
                        END {
                            used = total - avail
                            printf("%.1f %.2f", used/total*100, used/1024/1024)
                        }
                    ' /proc/meminfo
                }
                read mem_percent mem_used_gb <<< "$(get_mem_info)"
                echo "已使用 $mem_percent %，使用了 $mem_used_gb GB"
                read -p "按回车返回..."
                ;;
            7)
                echo -e "${CYAN}当前系统配置：${RESET}"
                hostnamectl
                read -p "按回车返回..."
                ;;
            8)
                echo -e "${CYAN}当前内核版本：${RESET}"
                uname -r
                read -p "按回车返回..."
                ;;
            9)
                echo -e "${CYAN}查看失败服务：${RESET}"
                failed=$(systemctl --failed --no-pager --plain --quiet | awk 'NR>1 {print $1}')
                if [ -z "$failed" ]; then
                    echo -e "${GREEN}当前没有失败服务${RESET}"
                else
                    for svc in $failed; do
                        echo -e "\n服务: $svc"
                        journalctl -u "$svc" -n 20 --no-pager
                    done
                fi
                read -p "按回车返回..."
                ;;
            10)
                echo -e "${CYAN}当前 IP 地址：${RESET}"
                echo -e "IPV4: ${GREEN}$SERVER_IP${RESET}"
                echo -e "IPV6: ${GREEN}$SERVER_IP6${RESET}"
                read -p "按回车返回..."
                ;;
            0) break ;;
            *) echo -e "${RED}无效选项${RESET}"; sleep 1 ;;
        esac
    done
}

# ---------- 更新 ----------
self_update(){
    echo -e "${GREEN}正在更新脚本...${RESET}"
    require_command curl
    bash <(curl -fsSL https://raw.githubusercontent.com/yduke/debian-scripts/main/install.sh)
    echo -e "${GREEN}脚本已更新到最新版本！${RESET}"
    echo -e "${GREEN}需要重启脚本生效。${RESET}"
    read -p "按回车退出脚本，你需要再次执行update使用新版。"
    exit 0
}

# ---------- 启动主菜单 ----------
main_menu
