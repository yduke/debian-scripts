# 5. MySQL binlog（>1天 且 >1MB）
_bt_clean_mysql_log() {
    echo -e "${YELLOW}>>> [5/13] MySQL binlog${RESET}"
    local mysql_dir
    mysql_dir=$(grep -i 'datadir' /etc/my.cnf 2>/dev/null | awk -F'=' '{print $2}' | tr -d ' ' | head -1)
    [ -z "$mysql_dir" ] && mysql_dir="/www/server/data"
    if [ ! -d "$mysql_dir" ]; then warn "MySQL 数据目录 $mysql_dir 不存在，跳过"; return; fi
    local count=0
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        local sz; sz=$(_bt_get_size "$f")
        [ "$sz" -le $((1024*1024)) ] && continue
        local age=$(( $(date +%s) - $(stat -c '%Y' "$f" 2>/dev/null || echo 0) ))
        [ "$age" -lt 86400 ] && continue
        BT_FREED=$(( BT_FREED + sz ))
        rm -f "$f"; info "已删除 binlog: $f  ($(_bt_to_size "$sz"))"; (( count++ ))
    done < <(find "$mysql_dir" -maxdepth 1 -name 'mysql-bin.0*' -type f 2>/dev/null)
    [ "$count" -eq 0 ] && warn "没有需要清理的 binlog"
}

# 6. 宝塔回收站
_bt_clean_recycle() {
    echo -e "${YELLOW}>>> [6/13] 宝塔回收站${RESET}"
    local rbin="/www/Recycle_bin"
    [ -d "$rbin" ] || { warn "$rbin 不存在，跳过"; return; }
    for item in "$rbin"/*; do
        [ -e "$item" ] || continue
        [[ "$item" != *"_bt_"* ]] && continue
        local sz; sz=$(_bt_get_size "$item")
        BT_FREED=$(( BT_FREED + sz ))
        rm -rf "$item"; info "已清理回收站: $item  ($(_bt_to_size "$sz"))"
    done
}

# 7. 邮件队列 & maillog
_bt_clean_mail() {
    echo -e "${YELLOW}>>> [7/13] 邮件队列 & maillog${RESET}"
    if [ -d /var/spool ]; then
        for dir in /var/spool/*/; do
            local dname; dname=$(basename "$dir")
            [[ "$dname" == "cron" || "$dname" == "anacron" ]] && continue
            for f in "$dir"*; do
                [ -f "$f" ] || continue
                [ "$(_bt_get_size "$f")" -eq 0 ] && continue
                local sz; sz=$(_bt_get_size "$f")
                BT_FREED=$(( BT_FREED + sz ))
                rm -f "$f"; info "已删除邮件: $f  ($(_bt_to_size "$sz"))"
            done
        done
    fi
    for f in /var/log/maillog*; do [ -f "$f" ] && _bt_truncate "$f"; done
}

# 8. PHP Session（find 批量，避免 glob 卡死）
_bt_clean_php_session() {
    echo -e "${YELLOW}>>> [8/13] PHP Session 文件${RESET}"
    local stats count=0 total_sz=0
    stats=$(find /tmp -maxdepth 1 -name 'sess_*' -type f -printf '%s\n' 2>/dev/null)
    if [ -z "$stats" ]; then warn "无 PHP Session 文件"; return; fi
    while IFS= read -r sz; do total_sz=$(( total_sz + sz )); (( count++ )); done <<< "$stats"
    find /tmp -maxdepth 1 -name 'sess_*' -type f -delete 2>/dev/null
    BT_FREED=$(( BT_FREED + total_sz ))
    info "已清理 $count 个 PHP Session 文件  ($(_bt_to_size "$total_sz"))"
}

# 9. 网站统计报表
_bt_clean_total_log() {
    echo -e "${YELLOW}>>> [9/13] 网站统计报表${RESET}"
    local total_config="/www/server/total/config.json"
    [ -f "$total_config" ] || { warn "未安装网站统计模块，跳过"; return; }
    local data_dir
    data_dir=$(python3 -c "
import json
try:
    c=json.load(open('$total_config'))
    print(c.get('global',{}).get('data_dir',''))
except: pass
" 2>/dev/null)
    [ -z "$data_dir" ] || [ ! -d "$data_dir" ] && { warn "无法读取统计报表目录，跳过"; return; }
    local today_db; today_db=$(date +%Y%m%d).db
    for item in "$data_dir"/*_bt_*; do
        [ -d "$item" ] || continue
        find "$item" -maxdepth 1 -type f \
            ! -name "total.db" ! -name "$today_db" ! -name "update_day.log" | while read -r f; do
            local fsz; fsz=$(_bt_get_size "$f")
            BT_FREED=$(( BT_FREED + fsz ))
            rm -f "$f"; info "已删除: $f  ($(_bt_to_size "$fsz"))"
        done
    done
}

# 10. PM2 日志
