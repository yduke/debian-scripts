# 12. 数据库 & 服务日志
_bt_clean_services() {
    echo -e "${YELLOW}>>> [12/13] 数据库 & 服务日志${RESET}"
    # Redis（>10KB，清空）
    [ -f /www/server/redis/redis.log ] && \
        [ "$(_bt_get_size /www/server/redis/redis.log)" -gt $((10*1024)) ] && \
        _bt_truncate /www/server/redis/redis.log
    # MongoDB / Supervisor / fail2ban
    _bt_clean_dir "/www/server/mongodb/logs" ".log" $((10*1024)) 1
    _bt_clean_dir "/var/log/supervisor"       ".log" 1024         1
    [ -f /var/log/fail2ban.log ] && \
        [ "$(_bt_get_size /var/log/fail2ban.log)" -gt 1024 ] && \
        _bt_truncate /var/log/fail2ban.log
    # 防篡改 / 面板安装 / 计划任务 / 负载均衡 / 文件同步 / Node
    _bt_truncate /www/server/panel/plugin/tamper_proof/service.log 2>/dev/null || true
    _bt_clean_dir "/www/server/panel/logs/installed" ".log" 1024 0
    _bt_clean_dir "/www/server/cron"                 ".log" 1024 0
    _bt_clean_dir_r "/www/wwwlogs/load_balancing"    ".log" 0    1
    _bt_clean_dir_r "/www/server/bt_sync/logs"       ".log" 0    1
    _bt_truncate /www/server/bt_sync/run_logs.log  2>/dev/null || true
    _bt_truncate /www/server/bt_sync/exec_logs.log 2>/dev/null || true
    _bt_clean_dir_r "/root/.node-gyp" ".log" 0 0
    # Nginx 缓存目录
    for ndir in /www/server/nginx/proxy_cache_dir /www/server/nginx/client_body_temp; do
        [ -d "$ndir" ] || continue
        local sz; sz=$(_bt_get_size "$ndir")
        find "$ndir" -type f -delete 2>/dev/null
        BT_FREED=$(( BT_FREED + sz ))
        info "已清理 Nginx 缓存: $ndir  ($(_bt_to_size "$sz"))"
    done
}

# 13. 面板自身日志
_bt_clean_panel_logs() {
    echo -e "${YELLOW}>>> [13/13] 面板自身日志${RESET}"
    local panel_log_dir="/www/server/panel/logs"
    [ -d "$panel_log_dir" ] || { warn "$panel_log_dir 不存在，跳过"; return; }
    for f in "$panel_log_dir"/*.log; do
        [ -f "$f" ] || continue
        [ "$(_bt_get_size "$f")" -lt 1024 ] && continue
        _bt_truncate "$f"
    done
}

# 主入口：供菜单 4->7 调用
bt_log_clean() {
    if [ "$(id -u)" -ne 0 ]; then
        echo -e "${RED}[ERROR] ${T_ROOT_REQUIRED}${RESET}"; sleep 2; return
    fi
    BT_FREED=0
    echo ""
    echo -e "${CYAN}============================================${RESET}"
    echo -e "${CYAN}    ${T_BT_TITLE}${RESET}"
    echo -e "${CYAN}============================================${RESET}"
    echo "${T_START_TIME}$(date '+%Y-%m-%d %H:%M:%S')"
    echo ""
    _bt_clean_system_log
    _bt_clean_panel_residue
    _bt_clean_www_log
    _bt_clean_usranalyse_log
    _bt_clean_mysql_log
    _bt_clean_recycle
    _bt_clean_mail
    _bt_clean_php_session
    _bt_clean_total_log
    _bt_clean_pm2
    _bt_clean_docker
    _bt_clean_services
    _bt_clean_panel_logs
    echo ""
    echo -e "${CYAN}============================================${RESET}"
    echo -e "${GREEN}  ${T_BT_DONE}$(_bt_to_size "$BT_FREED")${RESET}"
    echo "${T_END_TIME}$(date '+%Y-%m-%d %H:%M:%S')"
    echo -e "${CYAN}============================================${RESET}"
    read -p "${T_PRESS_ENTER}"
}


