# ---------- 4 系统管理 ----------
system_menu() {
    while true; do
        clear
        echo -e "${BLUE}${T_SYS_MGMT}${RESET}"
        echo -e "${YELLOW}${T_SSH_ENABLE}${RESET}"
        echo -e "${YELLOW}${T_DDNS_INSTALL_UPDATE}${RESET}"
        echo -e "${RED}${T_DDNS_UNINSTALL}${RESET}"
        echo -e "${CYAN}${T_OPENCLAW_INSTALL}${RESET}"
        echo -e "${CYAN}${T_OPENCLAW_PLUGINS}${RESET}"
        echo -e "${YELLOW}${T_LOG_LIMIT}${RESET}"
        echo -e "${YELLOW}${T_BT_CLEAN}${RESET}"
        echo -e "${YELLOW}${T_RETURN_MAIN}${RESET}"
        read -p "${T_PROMPT}" choice
        case "$choice" in
            1)
                echo -e "${GREEN}${T_SSH_ENABLING}${RESET}"
                if [ "$EUID" -ne 0 ]; then
                    echo -e "${YELLOW}${T_ROOT_REQUIRED}${RESET}"
                    echo -e "${YELLOW}${T_PERMISSION_DENIED}${RESET}"
                    exit 1
                fi

                SSHD_CONFIG="/etc/ssh/sshd_config"

                if ! dpkg -l | grep -qw openssh-server; then
                    echo -e "${YELLOW}${T_SSH_INSTALLING}${RESET}"
                    apt update
                    apt install -y openssh-server
                else
                    echo -e "${GREEN}${T_SSH_INSTALLED}${RESET}"
                fi

                BACKUP_FILE="/etc/ssh/sshd_config.bak.$(date +%F-%T)"
                cp "$SSHD_CONFIG" "$BACKUP_FILE"
                echo -e "${GREEN}${T_BACKUP_TO} $BACKUP_FILE${RESET}"

                if grep -qE "^\s*PermitRootLogin" "$SSHD_CONFIG"; then
                    sed -i "s/^\s*PermitRootLogin.*/PermitRootLogin yes/" "$SSHD_CONFIG"
                else
                    echo "PermitRootLogin yes" >> "$SSHD_CONFIG"
                fi

                if grep -qE "^\s*PasswordAuthentication" "$SSHD_CONFIG"; then
                    sed -i "s/^\s*PasswordAuthentication.*/PasswordAuthentication yes/" "$SSHD_CONFIG"
                else
                    echo "PasswordAuthentication yes" >> "$SSHD_CONFIG"
                fi

                systemctl enable ssh

                systemctl restart ssh
                if [ $? -eq 0 ]; then
                    echo -e "${GREEN}${T_SSH_RESTARTED}${RESET}"
                    echo -e "${GREEN}${T_SSH_LOGIN_INFO}${RESET}"
                else
                    echo -e "${RED}${T_SSH_RESTART_FAIL} $SSHD_CONFIG${RESET}"
                fi
                read -p "${T_PRESS_ENTER}"
                ;;
            2)
                INSTALL_DIR="/usr/local/ddns-go"
                SERVICE_FILE="/etc/systemd/system/ddns-go.service"

                echo -e "${GREEN}${T_DDNS_FETCHING}${RESET}"
                require_command curl

                LATEST_VERSION=$(curl -s https://api.github.com/repos/jeessy2/ddns-go/releases/latest | grep tag_name | cut -d '"' -f 4)

                if [ -z "$LATEST_VERSION" ]; then
                    echo -e "${RED}${T_DDNS_FETCH_FAIL}${RESET}"
                    exit 1
                fi

                echo -e "${GREEN}${T_LATEST_VER}${LATEST_VERSION}${RESET}"

                TAR_FILE="ddns-go_${LATEST_VERSION#v}_linux_x86_64.tar.gz"
                DOWNLOAD_URL="https://github.com/jeessy2/ddns-go/releases/download/${LATEST_VERSION}/${TAR_FILE}"

                echo -e "${GREEN}${T_DOWNLOAD_URL}${DOWNLOAD_URL}${RESET}"

                if systemctl is-active --quiet ddns-go.service; then
                    MODE="update"
                    echo -e "${GREEN}${T_DDNS_RUNNING_UPDATE}${RESET}"
                else
                    if [ -f "$SERVICE_FILE" ]; then
                        MODE="update"
                        echo -e "${GREEN}${T_DDNS_INSTALLED_UPDATE}${RESET}"
                    else
                        MODE="install"
                        echo -e "${GREEN}${T_DDNS_FRESH_INSTALL}${RESET}"
                    fi
                fi

                if [ "$MODE" = "update" ]; then
                    echo -e "${GREEN}${T_DDNS_STOPPING}${RESET}"
                    systemctl stop ddns-go.service || true
                fi

                echo -e "${GREEN}${T_CREATING_DIR}${INSTALL_DIR}${RESET}"
                mkdir -p "$INSTALL_DIR"
                cd "$INSTALL_DIR"

                echo -e "${GREEN}${T_DDNS_DOWNLOADING}${RESET}"
                if [ -f "$TAR_FILE" ]; then
                    echo -e "${GREEN}${T_DDNS_CACHED}${RESET}"
                else
                    wget -O "$TAR_FILE" "$DOWNLOAD_URL"
                fi

                echo -e "${GREEN}${T_EXTRACTING}${RESET}"
                tar -zxvf "$TAR_FILE"
                if [ "$MODE" = "update" ]; then
                    echo -e "${GREEN}${T_DDNS_UNINSTALLING_SVC}${RESET}"
                    "${INSTALL_DIR}/ddns-go" -s uninstall || true
                fi
                echo -e "${GREEN}${T_DDNS_INSTALLING_SVC}${RESET}"
                "${INSTALL_DIR}/ddns-go" -s install

                systemctl daemon-reload

                echo -e "${GREEN}${T_DDNS_STARTING}${RESET}"
                systemctl start ddns-go.service

                echo -e "${GREEN}${T_ENABLING_AUTOSTART}${RESET}"
                systemctl enable ddns-go.service

                echo -e "${GREEN}${T_CLEANING_FILES}${RESET}"
                rm -f "$TAR_FILE"
                rm -f "${INSTALL_DIR}/README_EN.md"
                rm -f "${INSTALL_DIR}/README.md"
                rm -f "${INSTALL_DIR}/LICENSE"

                echo -e "${GREEN}${T_FW_ALLOWING}${RESET}"
                if command -v ufw >/dev/null 2>&1; then
                    echo -e "${GREEN}${T_UFW_ALLOW}${RESET}"
                    ufw allow 9876/tcp || true
                fi

                echo -e "${GREEN}${T_DDNS_DONE_PREFIX}${MODE}${T_DDNS_DONE_SUFFIX}${LATEST_VERSION}${RESET}"

                if [[ "$SERVER_IP" = "NO_IP" ]]; then
                    echo -e "${YELLOW}${T_WEB_ACCESS}${RESET}"
                else
                    echo -e "${GREEN}${T_WEB_ACCESS_IP}${SERVER_IP}:9876${RESET}"
                fi

                read -p "${T_PRESS_ENTER}"
                ;;
            3)
                echo -e "${RED}${T_DDNS_UNINSTALL_TITLE}${RESET}"
                INSTALL_DIR="/usr/local/ddns-go"
                SERVICE_FILE="/etc/systemd/system/ddns-go.service"
                if systemctl is-active --quiet ddns-go.service; then
                    MODE="uninstall"
                    echo -e "${GREEN}${T_DDNS_RUNNING_UNINSTALL}${RESET}"
                else
                    if [ -f "$SERVICE_FILE" ]; then
                        MODE="uninstall"
                        echo -e "${GREEN}${T_DDNS_INSTALLED_UNINSTALL}${RESET}"
                    else
                        echo -e "${GREEN}${T_DDNS_NOT_INSTALLED}${RESET}"
                        exit 1
                    fi
                fi
                echo -e "${GREEN}${T_DDNS_STOPPING}${RESET}"
                systemctl stop ddns-go.service || true
                echo -e "${GREEN}${T_DDNS_UNINSTALL_SVC}${RESET}"
                "${INSTALL_DIR}/ddns-go" -s uninstall || true
                echo -e "${GREEN}${T_DDNS_UNINSTALL_DONE}${RESET}"
                echo -e "${GREEN}${T_REMOVING_DIR}${RESET}"
                rm -rf "$INSTALL_DIR"
                echo -e "${GREEN}${T_DDNS_UNINSTALL_COMPLETE}${RESET}"
                read -p "${T_PRESS_ENTER}"
                ;;
            4)
                echo -e "${GREEN}${T_OPENCLAW_START}${RESET}"
                require_command curl
                curl -fsSL https://openclaw.ai/install.sh | bash
                read -p "${T_PRESS_ENTER}"
                ;;
            5)
                if command -v openclaw >/dev/null 2>&1; then
                    echo "OpenClaw is installed."
                    echo "Installing WeCom plugin..."
                    openclaw plugins install @wecom/wecom-openclaw-plugin
                    npx -y @larksuite/openclaw-lark-tools install
                    echo "Plugin installation completed."
                else
                    echo "OpenClaw not found."
                    echo "Installing OpenClaw..."
                    require_command curl
                    curl -fsSL https://openclaw.ai/install.sh | bash
                    echo "OpenClaw installation completed, install WeCom plugin."
                    openclaw plugins install @wecom/wecom-openclaw-plugin
                    npx -y @larksuite/openclaw-lark-tools install
                    echo "Plugin installation completed."
                fi
                ;;
            6)
                echo -e "${GREEN}${T_LOG_LIMIT_START}${RESET}"
                echo -e "${GREEN}${T_LOG_LIMIT_INFO}${RESET}"
                CONF_FILE="/etc/systemd/journald.conf"
                if grep -q "^SystemMaxUse=" "$CONF_FILE"; then
                    sed -i 's/^SystemMaxUse=.*/SystemMaxUse=300M/' "$CONF_FILE"
                else
                    echo "SystemMaxUse=300M" >> "$CONF_FILE"
                fi
                echo -e "${GREEN}${T_LOG_LIMIT_SET}${RESET}"
                systemctl restart systemd-journald
                echo -e "${GREEN}${T_LOG_LIMIT_DONE}${RESET}"
                read -p "${T_PRESS_ENTER}"
                ;;
            7) bt_log_clean ;;
            0) break ;;
            *) echo -e "${RED}${T_INVALID}${RESET}"; sleep 1 ;;
        esac
    done
}




# ---------- 4-7 宝塔面板日志清理（辅助函数）----------

# 字节数转可读大小
_bt_to_size() {
    local size=$1
    if   [ "$size" -ge $((1024*1024*1024)) ]; then echo "$(( size/1024/1024/1024 ))GB"
    elif [ "$size" -ge $((1024*1024)) ];       then echo "$(( size/1024/1024 ))MB"
    elif [ "$size" -ge 1024 ];                 then echo "$(( size/1024 ))KB"
    else echo "${size}B"; fi
}

# 获取文件或目录字节大小
_bt_get_size() {
    if   [ -f "$1" ]; then stat -c '%s' "$1" 2>/dev/null || echo 0
    elif [ -d "$1" ]; then du -sb "$1" 2>/dev/null | awk '{print $1}' || echo 0
    else echo 0; fi
}

# 清空日志文件内容（保留文件）
_bt_truncate() {
    local f="$1"
    [ -f "$f" ] || return
    local sz; sz=$(_bt_get_size "$f")
    BT_FREED=$(( BT_FREED + sz ))
    > "$f"
    info "已清空: $f  ($(_bt_to_size "$sz"))"
}

# 删除单个文件
_bt_rm_file() {
    local f="$1"
    [ -f "$f" ] || return
    local sz; sz=$(_bt_get_size "$f")
    BT_FREED=$(( BT_FREED + sz ))
    rm -f "$f"
    info "已删除: $f  ($(_bt_to_size "$sz"))"
}

# 按扩展名清理目录（不递归）
# 用法: _bt_clean_dir <目录> <扩展名|""> <最小字节> <1=清空|0=删除>
_bt_clean_dir() {
    local dir="$1" ext="$2" min_sz="${3:-0}" do_trunc="${4:-0}"
    [ -d "$dir" ] || return
    for f in "$dir"/*; do
        [ -f "$f" ] || continue
        [[ -n "$ext" && "$f" != *"$ext" ]] && continue
        local sz; sz=$(_bt_get_size "$f")
        [ "$sz" -le "$min_sz" ] && continue
        BT_FREED=$(( BT_FREED + sz ))
        if [ "$do_trunc" -eq 1 ]; then > "$f"; info "已清空: $f  ($(_bt_to_size "$sz"))"
        else rm -f "$f";                       info "已删除: $f  ($(_bt_to_size "$sz"))"; fi
    done
}

# 按扩展名递归清理目录
_bt_clean_dir_r() {
    local dir="$1" ext="$2" min_sz="${3:-0}" do_trunc="${4:-0}"
    [ -d "$dir" ] || return
    while IFS= read -r -d '' f; do
        [[ -n "$ext" && "$f" != *"$ext" ]] && continue
        local sz; sz=$(_bt_get_size "$f")
        [ "$sz" -le "$min_sz" ] && continue
        BT_FREED=$(( BT_FREED + sz ))
        if [ "$do_trunc" -eq 1 ]; then > "$f"; info "已清空: $f  ($(_bt_to_size "$sz"))"
        else rm -f "$f";                        info "已删除: $f  ($(_bt_to_size "$sz"))"; fi
    done < <(find "$dir" -type f -print0 2>/dev/null)
}

# 1. 系统日志 /var/log
_bt_clean_system_log() {
    echo -e "${YELLOW}>>> [1/13] 系统登录日志${RESET}"
