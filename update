# ---------- 1 更新软件包 + 升级 + 清理 ----------
update_system() {
    echo -e "${GREEN}开始更新软件包列表...${RESET}"
    apt update -y
    echo -e "${GREEN}开始升级软件包...${RESET}"
    apt upgrade -y
    echo -e "${GREEN}开始清理不需要的软件包...${RESET}"
    apt autoremove -y
    apt clean
    read -p "完成！按回车返回主菜单..."
}

# ---------- 2 升级内核 ----------
upgrade_kernel() {
    echo -e "${GREEN}开始升级内核及相关软件包...${RESET}"
    apt update -y
    apt full-upgrade -y
    apt autoremove --purge -y
    if [ -f /var/run/reboot-required ]; then
        echo -e "${RED}系统需要重启！${RESET}"
    fi
    read -p "按回车返回主菜单..."
}

# ---------- 3 更换软件源 ----------
change_sources() {
    echo -e "${GREEN}正在获取换源脚本 ...${RESET}"
    # 检查 curl
    require_command curl
    bash <(curl -sSL https://linuxmirrors.cn/main.sh)
    read -p "按回车返回主菜单..."
}


# ---------- 4 系统管理 ----------
system_menu() {
    while true; do
        clear
        echo -e "${BLUE}----- 系统管理 -----${RESET}"
        echo -e "${YELLOW}1)${RESET} 开启SSH远程密码登录"
        echo -e "${YELLOW}2)${RESET} 安装或更新 ddns-go"
        echo -e "${RED}3) 卸载 ddns-go${RESET}"
        echo -e "${CYAN}4)${RESET} 安装OpenClaw"
        echo -e "${CYAN}5)${RESET} 安装OpenClaw飞书 企业微信插件"
        echo -e "${YELLOW}6)${RESET} 限制日志文件大小300M"
        echo -e "${YELLOW}7)${RESET} 日志清理（仅宝塔面板）"
        echo -e "${YELLOW}0)${RESET} 返回主菜单"
        read -p "请输入选项: " choice
        case "$choice" in
            1)
                echo -e "${GREEN}🔧 开启 SSH 远程密码登录...${RESET}"
                # 确保以 root 用户运行
                if [ "$EUID" -ne 0 ]; then
                    echo -e "${YELLOW}请使用 root 用户运行此脚本！${RESET}"
                    echo -e "${YELLOW}权限不足，退出！${RESET}"
                    exit 1
                fi

                SSHD_CONFIG="/etc/ssh/sshd_config"

                # 检查 openssh-server 是否安装
                if ! dpkg -l | grep -qw openssh-server; then
                    echo -e "${YELLOW}系统未安装 openssh-server，正在安装...${RESET}"
                    apt update
                    apt install -y openssh-server
                else
                    echo -e "${GREEN}openssh-server 已安装。${RESET}"
                fi

                # 备份原始配置文件
                BACKUP_FILE="/etc/ssh/sshd_config.bak.$(date +%F-%T)"
                cp "$SSHD_CONFIG" "$BACKUP_FILE"
                echo -e "${GREEN}已备份原始配置到 $BACKUP_FILE${RESET}"

                # 修改或添加 PermitRootLogin yes
                if grep -qE "^\s*PermitRootLogin" "$SSHD_CONFIG"; then
                    sed -i "s/^\s*PermitRootLogin.*/PermitRootLogin yes/" "$SSHD_CONFIG"
                else
                    echo "PermitRootLogin yes" >> "$SSHD_CONFIG"
                fi

                # 修改或添加 PasswordAuthentication yes
                if grep -qE "^\s*PasswordAuthentication" "$SSHD_CONFIG"; then
                    sed -i "s/^\s*PasswordAuthentication.*/PasswordAuthentication yes/" "$SSHD_CONFIG"
                else
                    echo "PasswordAuthentication yes" >> "$SSHD_CONFIG"
                fi

                # 确保 SSH 服务启动
                systemctl enable ssh

                # 重启 SSH 服务
                systemctl restart ssh
                if [ $? -eq 0 ]; then
                    echo -e "${GREEN}SSH 服务已重启，远程登录已开启。${RESET}"
                    echo -e "${GREEN}你现在可以使用 root 或普通用户通过密码远程登录 SSH。${RESET}"
                else
                    echo -e "${RED}SSH 服务重启失败，请重试或手动检查配置文件：$SSHD_CONFIG${RESET}"
                fi
                read -p "按回车返回..."
                ;;
            2)
                INSTALL_DIR="/usr/local/ddns-go"
                SERVICE_FILE="/etc/systemd/system/ddns-go.service"

                echo -e "${GREEN}开始查询 ddns-go 最新版本...${RESET}"
                require_command curl

                LATEST_VERSION=$(curl -s https://api.github.com/repos/jeessy2/ddns-go/releases/latest | grep tag_name | cut -d '"' -f 4)

                if [ -z "$LATEST_VERSION" ]; then
                    echo -e "${RED}获取最新版本失败，退出。${RESET}"
                    exit 1
                fi

                echo -e "${GREEN}最新版本: $LATEST_VERSION${RESET}"

                # 构造下载 URL
                TAR_FILE="ddns-go_${LATEST_VERSION#v}_linux_x86_64.tar.gz"
                DOWNLOAD_URL="https://github.com/jeessy2/ddns-go/releases/download/${LATEST_VERSION}/${TAR_FILE}"

                echo -e "${GREEN}下载地址: $DOWNLOAD_URL${RESET}"

                # 判断是否已经安装
                if systemctl is-active --quiet ddns-go.service; then
                    MODE="update"
                    echo -e "${GREEN}检测到 ddns-go 正在运行，将执行更新操作...${RESET}"
                else
                    if [ -f "$SERVICE_FILE" ]; then
                        MODE="update"
                        echo -e "${GREEN}检测到 ddns-go 已安装但未运行，将执行更新操作...${RESET}"
                    else
                        MODE="install"
                        echo -e "${GREEN}ddns-go 未安装，将执行全新安装...${RESET}"
                    fi
                fi

                # 停止服务（如已安装）
                if [ "$MODE" = "update" ]; then
                    echo -e "${GREEN}停止 ddns-go.service ...${RESET}"
                    systemctl stop ddns-go.service || true
                fi

                echo -e "${GREEN}创建目录: $INSTALL_DIR${RESET}"
                mkdir -p "$INSTALL_DIR"
                cd "$INSTALL_DIR"

                echo -e "${GREEN}下载最新版 ddns-go...${RESET}"
                if [ -f "$TAR_FILE" ]; then
                    echo -e "${GREEN}发现本地已存在 $TAR_FILE ，跳过下载。${RESET}"
                else
                    echo -e "${GREEN}正在下载 $TAR_FILE ...${RESET}"
                    wget -O "$TAR_FILE" "$DOWNLOAD_URL"
                fi

                echo -e "${GREEN}解压覆盖...${RESET}"
                tar -zxvf "$TAR_FILE"
                if [ "$MODE" = "update" ]; then
                    echo -e "${GREEN}卸载旧的 ddns-go systemd 服务...${RESET}"
                    "${INSTALL_DIR}/ddns-go" -s uninstall || true
                    echo -e "${GREEN}旧服务卸载完成。${RESET}"
                fi
                echo -e "${GREEN}安装/更新 systemd 服务...${RESET}"
                "${INSTALL_DIR}/ddns-go" -s install

                echo -e "${GREEN}重载 systemctl...${RESET}"
                systemctl daemon-reload

                echo -e "${GREEN}启动 ddns-go.service...${RESET}"
                systemctl start ddns-go.service

                echo -e "${GREEN}设置开机自启...${RESET}"
                systemctl enable ddns-go.service

                echo -e "${GREEN}清理安装文件...${RESET}"
                rm -f "$TAR_FILE"
                rm -f "${INSTALL_DIR}/README_EN.md"
                rm -f "${INSTALL_DIR}/README.md"
                rm -f "${INSTALL_DIR}/LICENSE"

                echo -e "${GREEN}防火墙放行...${RESET}"
                if command -v ufw >/dev/null 2>&1; then
                    echo -e "${GREEN}检测到 UFW，放行端口 9876...${RESET}"
                    ufw allow 9876/tcp || true
                fi

                echo -e "${GREEN}ddns-go $MODE 完成！当前版本：$LATEST_VERSION${RESET}"
   
                if [[ "$SERVER_IP" = "无法自动获取 IP" ]]; then
                    echo -e "${YELLOW}Web 界面访问: http://你的IP:9876${RESET}"
                else
                    echo -e "${GREEN}Web 界面访问: http://$SERVER_IP:9876${RESET}"
                fi

                read -p "按回车返回..."
                ;;
            3)
                echo -e "${RED}卸载 ddns-go${RESET}"
                INSTALL_DIR="/usr/local/ddns-go"
                SERVICE_FILE="/etc/systemd/system/ddns-go.service"
                # 判断是否已经安装
                if systemctl is-active --quiet ddns-go.service; then
                    MODE="uninstall"
                    echo -e "${GREEN}检测到 ddns-go 正在运行，将执行卸载...${RESET}"
                else
                    if [ -f "$SERVICE_FILE" ]; then
                        MODE="uninstall"
                        echo -e "${GREEN}检测到 ddns-go 已安装但未运行，将执行卸载操作...${RESET}"
                    else
                        echo -e "${GREEN}ddns-go 未安装，无需卸载${RESET}"
                        exit 1
                    fi
                fi
                # 停止服务
                echo -e "${GREEN}停止 ddns-go.service ...${RESET}"
                systemctl stop ddns-go.service || true
                echo -e "${GREEN}卸载 ddns-go systemd 服务...${RESET}"
                "${INSTALL_DIR}/ddns-go" -s uninstall || true
                echo -e "${GREEN}服务卸载完成。${RESET}"
                echo -e "${GREEN}删除安装目录...${RESET}"
                rm -rf "$INSTALL_DIR"
                echo -e "${GREEN}ddns-go 卸载完成！${RESET}"
                read -p "按回车返回..."
                ;;
            4)
                echo -e "${GREEN}开始安装 OpenClaw...${RESET}"
                require_command curl
                curl -fsSL https://openclaw.ai/install.sh | bash
                read -p "按回车返回..."
                ;;
            5)
                if command -v openclaw >/dev/null 2>&1; then
                    echo "OpenClaw is installed."
                    echo "Installing WeCom plugin..."
                    openclaw plugins install @wecom/wecom-openclaw-plugin
                    npx -y @larksuite/openclaw-lark-tools install
                    echo "Plugin installation completed."
                else
                    echo "OpenClaw not found."
                    echo "Installing OpenClaw..."
                    require_command curl
                    curl -fsSL https://openclaw.ai/install.sh | bash
                    echo "OpenClaw installation completed, install WeCom plugin."
                    openclaw plugins install @wecom/wecom-openclaw-plugin
                    npx -y @larksuite/openclaw-lark-tools install
                    echo "Plugin installation completed."
                fi
                ;;
            6)
                echo -e "${GREEN}限制日志文件大小到300M ...${RESET}"
                echo -e "${GREEN}此功能会修改日志设置文件以保证日志文件不会超过300M${RESET}"
                # 1. 修改 journald.conf，设置 SystemMaxUse=300M
                CONF_FILE="/etc/systemd/journald.conf"
                # 如果已存在 SystemMaxUse 行，则替换；否则追加
                if grep -q "^SystemMaxUse=" "$CONF_FILE"; then
                    sed -i 's/^SystemMaxUse=.*/SystemMaxUse=300M/' "$CONF_FILE"
                else
                    echo "SystemMaxUse=300M" >> "$CONF_FILE"
                fi
                echo -e "${GREEN}已将 SystemMaxUse 设置为 300M，准备重启日志服务${RESET}"
                # 2. 重启 systemd-journald 生效
                systemctl restart systemd-journald
                echo -e "${GREEN}systemd-journald 已重启 日志大小300M限制已生效${RESET}"
                read -p "按回车返回..."
                ;;
            7) bt_log_clean ;;
            0) break ;;
            *) echo -e "${RED}无效选项${RESET}"; sleep 1 ;;
        esac
    done
}




# ---------- 4-7 宝塔面板日志清理（辅助函数）----------

# 字节数转可读大小
_bt_to_size() {
    local size=$1
    if   [ "$size" -ge $((1024*1024*1024)) ]; then echo "$(( size/1024/1024/1024 ))GB"
    elif [ "$size" -ge $((1024*1024)) ];       then echo "$(( size/1024/1024 ))MB"
    elif [ "$size" -ge 1024 ];                 then echo "$(( size/1024 ))KB"
    else echo "${size}B"; fi
}

# 获取文件或目录字节大小
_bt_get_size() {
    if   [ -f "$1" ]; then stat -c '%s' "$1" 2>/dev/null || echo 0
    elif [ -d "$1" ]; then du -sb "$1" 2>/dev/null | awk '{print $1}' || echo 0
    else echo 0; fi
}

# 清空日志文件内容（保留文件）
_bt_truncate() {
    local f="$1"
    [ -f "$f" ] || return
    local sz; sz=$(_bt_get_size "$f")
    BT_FREED=$(( BT_FREED + sz ))
    > "$f"
    info "已清空: $f  ($(_bt_to_size "$sz"))"
}

# 删除单个文件
_bt_rm_file() {
    local f="$1"
    [ -f "$f" ] || return
    local sz; sz=$(_bt_get_size "$f")
    BT_FREED=$(( BT_FREED + sz ))
    rm -f "$f"
    info "已删除: $f  ($(_bt_to_size "$sz"))"
}

# 按扩展名清理目录（不递归）
# 用法: _bt_clean_dir <目录> <扩展名|""> <最小字节> <1=清空|0=删除>
_bt_clean_dir() {
    local dir="$1" ext="$2" min_sz="${3:-0}" do_trunc="${4:-0}"
    [ -d "$dir" ] || return
    for f in "$dir"/*; do
        [ -f "$f" ] || continue
        [[ -n "$ext" && "$f" != *"$ext" ]] && continue
        local sz; sz=$(_bt_get_size "$f")
        [ "$sz" -le "$min_sz" ] && continue
        BT_FREED=$(( BT_FREED + sz ))
        if [ "$do_trunc" -eq 1 ]; then > "$f"; info "已清空: $f  ($(_bt_to_size "$sz"))"
        else rm -f "$f";                       info "已删除: $f  ($(_bt_to_size "$sz"))"; fi
    done
}

# 按扩展名递归清理目录
_bt_clean_dir_r() {
    local dir="$1" ext="$2" min_sz="${3:-0}" do_trunc="${4:-0}"
    [ -d "$dir" ] || return
    while IFS= read -r -d '' f; do
        [[ -n "$ext" && "$f" != *"$ext" ]] && continue
        local sz; sz=$(_bt_get_size "$f")
        [ "$sz" -le "$min_sz" ] && continue
        BT_FREED=$(( BT_FREED + sz ))
        if [ "$do_trunc" -eq 1 ]; then > "$f"; info "已清空: $f  ($(_bt_to_size "$sz"))"
        else rm -f "$f";                        info "已删除: $f  ($(_bt_to_size "$sz"))"; fi
    done < <(find "$dir" -type f -print0 2>/dev/null)
}

# 1. 系统日志 /var/log
_bt_clean_system_log() {
    echo -e "${YELLOW}>>> [1/13] 系统登录日志${RESET}"
    [ -d /var/log/audit ] && for f in /var/log/audit/*; do [ -f "$f" ] && _bt_truncate "$f"; done
    for f in /var/log/*; do
        [ -f "$f" ] || continue
        [[ "$f" == *"maillog"* ]] && continue
        [ "$(_bt_get_size "$f")" -lt 100 ] && continue
        _bt_truncate "$f"
    done
}

# 2. 面板遗留文件
_bt_clean_panel_residue() {
    echo -e "${YELLOW}>>> [2/13] 面板遗留文件${RESET}"
    for f in /www/server/panel/testDisk_*; do [ -f "$f" ] && _bt_rm_file "$f"; done
    [ -f /tmp/panelBoot.pl ] && _bt_rm_file /tmp/panelBoot.pl
    for ext in .rpm .zip .gz; do
        for f in /www/server/panel/install/*"$ext"; do [ -f "$f" ] && _bt_rm_file "$f"; done
    done
}

# 3. 网站访问日志 /www/wwwlogs（清空不删除，避免 Nginx 报错）
_bt_clean_www_log() {
    echo -e "${YELLOW}>>> [3/13] 网站访问日志${RESET}"
    for dir in /www/wwwlogs /www/wwwlogs/btwaf; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*log*; do
            [ -f "$f" ] || continue
            [ "$(_bt_get_size "$f")" -lt 1024 ] && continue
            BT_FREED=$(( BT_FREED + $(_bt_get_size "$f") ))
            > "$f"; info "已清空: $f"
        done
    done
}

# 4. 堡塔防入侵日志
_bt_clean_usranalyse_log() {
    echo -e "${YELLOW}>>> [4/13] 堡塔防入侵日志${RESET}"
    for dir in /usr/local/usranalyse/logs/log/www \
               /usr/local/usranalyse/logs/total/www \
               /usr/local/usranalyse/logs/log/root \
               /usr/local/usranalyse/logs/total/root; do
        _bt_clean_dir "$dir" ".txt" 1024 0
    done
}

# 5. MySQL binlog（>1天 且 >1MB）
_bt_clean_mysql_log() {
    echo -e "${YELLOW}>>> [5/13] MySQL binlog${RESET}"
    local mysql_dir
    mysql_dir=$(grep -i 'datadir' /etc/my.cnf 2>/dev/null | awk -F'=' '{print $2}' | tr -d ' ' | head -1)
    [ -z "$mysql_dir" ] && mysql_dir="/www/server/data"
    if [ ! -d "$mysql_dir" ]; then warn "MySQL 数据目录 $mysql_dir 不存在，跳过"; return; fi
    local count=0
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        local sz; sz=$(_bt_get_size "$f")
        [ "$sz" -le $((1024*1024)) ] && continue
        local age=$(( $(date +%s) - $(stat -c '%Y' "$f" 2>/dev/null || echo 0) ))
        [ "$age" -lt 86400 ] && continue
        BT_FREED=$(( BT_FREED + sz ))
        rm -f "$f"; info "已删除 binlog: $f  ($(_bt_to_size "$sz"))"; (( count++ ))
    done < <(find "$mysql_dir" -maxdepth 1 -name 'mysql-bin.0*' -type f 2>/dev/null)
    [ "$count" -eq 0 ] && warn "没有需要清理的 binlog"
}

# 6. 宝塔回收站
_bt_clean_recycle() {
    echo -e "${YELLOW}>>> [6/13] 宝塔回收站${RESET}"
    local rbin="/www/Recycle_bin"
    [ -d "$rbin" ] || { warn "$rbin 不存在，跳过"; return; }
    for item in "$rbin"/*; do
        [ -e "$item" ] || continue
        [[ "$item" != *"_bt_"* ]] && continue
        local sz; sz=$(_bt_get_size "$item")
        BT_FREED=$(( BT_FREED + sz ))
        rm -rf "$item"; info "已清理回收站: $item  ($(_bt_to_size "$sz"))"
    done
}

# 7. 邮件队列 & maillog
_bt_clean_mail() {
    echo -e "${YELLOW}>>> [7/13] 邮件队列 & maillog${RESET}"
    if [ -d /var/spool ]; then
        for dir in /var/spool/*/; do
            local dname; dname=$(basename "$dir")
            [[ "$dname" == "cron" || "$dname" == "anacron" ]] && continue
            for f in "$dir"*; do
                [ -f "$f" ] || continue
                [ "$(_bt_get_size "$f")" -eq 0 ] && continue
                local sz; sz=$(_bt_get_size "$f")
                BT_FREED=$(( BT_FREED + sz ))
                rm -f "$f"; info "已删除邮件: $f  ($(_bt_to_size "$sz"))"
            done
        done
    fi
    for f in /var/log/maillog*; do [ -f "$f" ] && _bt_truncate "$f"; done
}

# 8. PHP Session（find 批量，避免 glob 卡死）
_bt_clean_php_session() {
    echo -e "${YELLOW}>>> [8/13] PHP Session 文件${RESET}"
    local stats count=0 total_sz=0
    stats=$(find /tmp -maxdepth 1 -name 'sess_*' -type f -printf '%s\n' 2>/dev/null)
    if [ -z "$stats" ]; then warn "无 PHP Session 文件"; return; fi
    while IFS= read -r sz; do total_sz=$(( total_sz + sz )); (( count++ )); done <<< "$stats"
    find /tmp -maxdepth 1 -name 'sess_*' -type f -delete 2>/dev/null
    BT_FREED=$(( BT_FREED + total_sz ))
    info "已清理 $count 个 PHP Session 文件  ($(_bt_to_size "$total_sz"))"
}

# 9. 网站统计报表
_bt_clean_total_log() {
    echo -e "${YELLOW}>>> [9/13] 网站统计报表${RESET}"
    local total_config="/www/server/total/config.json"
    [ -f "$total_config" ] || { warn "未安装网站统计模块，跳过"; return; }
    local data_dir
    data_dir=$(python3 -c "
import json
try:
    c=json.load(open('$total_config'))
    print(c.get('global',{}).get('data_dir',''))
except: pass
" 2>/dev/null)
    [ -z "$data_dir" ] || [ ! -d "$data_dir" ] && { warn "无法读取统计报表目录，跳过"; return; }
    local today_db; today_db=$(date +%Y%m%d).db
    for item in "$data_dir"/*_bt_*; do
        [ -d "$item" ] || continue
        find "$item" -maxdepth 1 -type f \
            ! -name "total.db" ! -name "$today_db" ! -name "update_day.log" | while read -r f; do
            local fsz; fsz=$(_bt_get_size "$f")
            BT_FREED=$(( BT_FREED + fsz ))
            rm -f "$f"; info "已删除: $f  ($(_bt_to_size "$fsz"))"
        done
    done
}

