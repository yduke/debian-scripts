# ─────────────────────────────────────────────
# 从文件服务器下载证书文件
# ─────────────────────────────────────────────
download_certs() {
    info "正在从 ${CERT_SERVER} 下载证书文件..."

    local urls=("${CERT_URL}" "${KEY_URL}" "${PEM_URL}" "${ISSUER_URL}")
    local files=("${CERT_FILE}" "${KEY_FILE}" "${PEM_FILE}" "${ISSUER_FILE}")

    for i in "${!urls[@]}"; do
        info "  下载 ${urls[$i]}"
        if ! curl -fsSL --connect-timeout 10 --max-time 30 \
                "${urls[$i]}" -o "${files[$i]}"; then
            error "下载失败：${urls[$i]}"
            error "请确认 192.168.2.1:16666 服务可访问，且当前机器在局域网内"
            exit 1
        fi
    done

    success "证书文件下载完成，存放于 ${TMP_DIR}"
}

