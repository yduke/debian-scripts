# 检查并安装命令
# 用法: require_command <命令名> [<包名>]
# 例如检查确保curl已安装：
# require_command curl
# 如果命令名和包名不同，第二个参数就可以指定包名：
# require_command python3 python3-pip

require_command() {
    local cmd=$1
    local pkg=${2:-$cmd}
    if ! command -v "$cmd" >/dev/null 2>&1; then
        if [ "$LANG_MODE" = "en" ]; then
            echo -e "${YELLOW}$cmd not found, installing $pkg...${RESET}"
        else
            echo -e "${YELLOW}未检测到 $cmd，正在安装 $pkg...${RESET}"
        fi
        apt update -y
        apt install -y "$pkg"
    fi
}

# 获取当前服务器 IPv4
get_ipv4() {
    # 1. 通过默认路由获取（最准确）
    local ip
    ip=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'src \K[0-9.]+')
    if [[ -n "$ip" ]]; then
        echo "$ip"
        return
    fi

    # 2. 使用 hostname -I
    ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    if [[ -n "$ip" ]]; then
        echo "$ip"
        return
    fi

    # 3. 外网探测（不保证成功，最后兜底）
    require_command curl
    ip=$(curl -4 -s https://api.ipify.org || true)
    if [[ -n "$ip" ]]; then
        echo "$ip"
        return
    fi

    echo "NO_IP"
}
SERVER_IP=$(get_ipv4)

get_ipv6() {
    ipv6=$(ip -6 addr show scope global | grep -oP 'inet6 \K[0-9a-f:]+')
    if [ -z "$ipv6" ]; then
        echo "No IPv6 address found"
    else
        echo "$ipv6"
    fi
}
SERVER_IP6=$(get_ipv6)


