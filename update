auto_detect_lang() {
    local charmap lang_var
    charmap=$(locale charmap 2>/dev/null || echo "")
    if [ -n "$charmap" ] && [ "$charmap" != "UTF-8" ] && [ "$charmap" != "utf8" ]; then
        LANG_MODE="en"
        return
    fi
    lang_var=$(locale 2>/dev/null | grep -E '^LANG=|^LC_ALL=' | head -1 | cut -d= -f2)
    if echo "$lang_var" | grep -qi 'zh_CN\|zh\.' >/dev/null 2>&1; then
        LANG_MODE="zh"
    else
        LANG_MODE="en"
    fi
}

toggle_lang() {
    if [ "$LANG_MODE" = "en" ]; then LANG_MODE="zh"; else LANG_MODE="en"; fi
    init_lang
}

# 初始化语言
auto_detect_lang
if [ -n "$UPDATE_LANG" ]; then
    case "$UPDATE_LANG" in
        en|EN|english|English) LANG_MODE="en" ;;
        zh|ZH|chinese|Chinese) LANG_MODE="zh" ;;
    esac
fi
init_lang

