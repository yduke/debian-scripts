    for dir in /www/wwwlogs /www/wwwlogs/btwaf; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*log*; do
            [ -f "$f" ] || continue
            [ "$(_bt_get_size "$f")" -lt 1024 ] && continue
