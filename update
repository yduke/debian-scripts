# ---------- 1 更新软件包 + 升级 + 清理 ----------
update_system() {
    echo -e "${GREEN}${T_UPDATING}${RESET}"
    apt update -y
    echo -e "${GREEN}${T_UPGRADING}${RESET}"
    apt upgrade -y
    echo -e "${GREEN}${T_CLEANING}${RESET}"
    apt autoremove -y
    apt clean
    read -p "${T_DONE}"
